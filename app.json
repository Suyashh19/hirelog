{
  "expo": {
    "name": "HireLog",
    "slug": "hourly-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hourlytracker.app",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1B6B4A"
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HireLog uses your location only during a trip or while measuring a field, to count the distance or area for the bill.",
          "locationAlwaysAndWhenInUsePermission": "HireLog uses your location only during a trip, to keep counting the distance when the screen is off.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "HireLog uses the camera only when you take a photo of a job, a meter or a receipt.",
          "photosPermission": "HireLog uses your photos only when you attach one to a job or add your logo."
        }
      ]
    ],
    "scheme": "hourlytracker"
  }
}
